{
  "name": "cf-affiliate",
  "version": "0.2.0",
  "description": "Self-hosted affiliate program for Cloudflare Workers + Stripe: referral links, checkout attribution, conversions, payouts, self-serve applications.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "functions",
    "migrations",
    "examples"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config e2e/vitest.config.js"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
